# Reproduces the toolchain on a new machine.
# Applied automatically by run_onchange_before_install-packages.sh.tmpl,
# which re-runs whenever this file changes.
#
# v12.0-audited baseline: cross-platform (macOS + Ubuntu Linux), strictly the
# tools named in that manifest plus the handful of implied dependencies noted
# where they appear. Everything else this environment used to install by
# default now lives in Brewfile.optional, installed by hand with `brewopt`.

# `brew bundle` is built into Homebrew now; no tap needed.

# ── Terminal / core workspace ────────────────────────────────────────────
# ghostty and the Nerd Font both ship as macOS casks only -- neither has a
# Homebrew formula, on either platform, so there is no Linux side to this via
# `brew bundle`. Linux gets both through apt/a direct download instead, in
# run_onchange_before_install-packages.sh.tmpl's linux block, not here.
{{ if eq .chezmoi.os "darwin" -}}
cask "ghostty"
# Implied dependency of Ghostty (and of starship's prompt glyphs below) --
# not itself named in the manifest, but nothing renders correctly without it.
# JetBrains Mono, per preference -- the font gotchas in CLAUDE.md are
# written against this family.
cask "font-jetbrains-mono-nerd-font"
{{ end -}}
brew "starship"
brew "direnv"
brew "zellij"
brew "neovim"
brew "chezmoi"
# Implied dependency: chezmoi itself, and git-based plugin/theme installs in
# the installer script, need a real git.
brew "git"

# Task runner. `bootstrap.sh` also installs this directly, before chezmoi
# exists to run this file at all -- see CLAUDE.md, "just is a hard
# prerequisite". Listed here too so `brew bundle` keeps it current.
brew "just"

# ── Security & networking ────────────────────────────────────────────────
# Password manager and secrets-manager CLIs. Installed as clients only -- no
# vault URL, no project token, no key material ships from this repo. See
# CLAUDE.md's secrets hard rule.
#
# infisical is this repo's designated source for any API key its tools read
# from the environment (OPENROUTER_API_KEY, LITELLM_API_KEY, CURSOR_API_KEY,
# ...). bitwarden-cli is installed for personal password-manager use -- a
# separate purpose, not an alternate way to source those.
brew "bitwarden-cli"
brew "infisical"
brew "tailscale"
brew "mosh"
brew "gitleaks"
brew "trivy"
brew "sops"
brew "age"
# Agent sandboxing. bubblewrap is Linux-only -- macOS has no equivalent
# package because sandbox-exec ships with the OS. See CLAUDE.md's templating
# conventions: this is install-mechanics, not a manifest decision.
{{ if eq .chezmoi.os "linux" -}}
brew "bubblewrap"
{{ end -}}

# ── AI & speech ───────────────────────────────────────────────────────────
# The local model server aider talks to, so aider needs no API key and no
# network. The FORMULA, not the `ollama-app` cask: the two conflict, and the
# cask installs an Electron menu-bar GUI this setup has no use for.
#
# Its Homebrew service block is worth knowing about -- `brew services start
# ollama` runs it under launchd with OLLAMA_FLASH_ATTENTION=1 and
# OLLAMA_KV_CACHE_TYPE=q8_0, both better than upstream's defaults. The same
# launchd path is why context size is set per-request in
# ~/.aider.model.settings.yml: launchd does not inherit a shell's environment,
# so OLLAMA_CONTEXT_LENGTH exported from ~/.zshenv would do nothing at all.
#
# Model weights are NOT installed here -- several GB, pulled per machine with
# `ollama pull`. There is no default; :AiModel presents the supported catalog
# once per Neovim session, and bootstrap.sh only checks that one is available.
brew "ollama"
brew "whisper-cpp"
brew "sox"
# uv -- implied dependency of aider, litellm and harlequin below, all three
# installed as `uv tool install` in run_onchange_before_install-packages.sh
# rather than as brew formulae. uv manages its own interpreter per tool, so a
# `brew upgrade python` cannot orphan them the way pipx-installed tools broke
# before (see the installer script for the frida/objection history of that
# failure mode, now moved to Brewfile.optional).
brew "uv"

# ── Architecture & diagrams ───────────────────────────────────────────────
brew "d2"
brew "adr-tools"

# ── Developer utilities ───────────────────────────────────────────────────
# mise owns node and java -- see ~/.config/mise/config.toml, the single
# place those versions are pinned. No global ruby any more (see that file);
# ruby-build, which mise's ruby backend needs to compile one, moved with it
# to Brewfile.optional's `mobile` group.
brew "mise"
brew "fzf"
brew "yazi"
brew "bat"
brew "eza"
brew "zoxide"
# tealdeer, not tlrc: same `tldr` binary, but tealdeer is the client this
# repo's custom pages (dot_config/tealdeer/pages/) target. Do not install
# both -- they conflict on the same binary name.
brew "tealdeer"
brew "atac"
brew "curlie"
brew "git-delta"
brew "procs"
brew "duf"
brew "bore-cli"
brew "hyperfine"
brew "jq"
brew "yq"
brew "duckdb"
brew "ripgrep"
brew "fd"

# BOTH tree-sitter formulae are needed and neither is redundant. `tree-sitter`
# is the library; `tree-sitter-cli` is the `tree-sitter` binary. nvim-treesitter
# is pinned to its `main` branch (see lazy-lock.json), which compiles parsers
# by shelling out to that binary -- without it, parsers fail to build and the
# only symptom is missing highlighting.
brew "tree-sitter"
brew "tree-sitter-cli"

# fontconfig is listed on purpose even though it would otherwise arrive as a
# transitive dependency. `fc-list` is the tool CLAUDE.md's Nerd Font gotcha
# says to run before committing a new codepoint -- without an explicit entry
# here it would just be whatever another formula happened to pull in.
brew "fontconfig"

# Implied dependency of image.nvim (dot_config/nvim/lua/plugins/diagram.lua)
# -- its default `magick_cli` processor shells out to ImageMagick's own
# `identify`/`convert` to scale and crop images before the Kitty graphics
# protocol draws them.
brew "imagemagick"

# ── Containers & code hosts ───────────────────────────────────────────────
brew "podman"
brew "lazydocker"
brew "act"
brew "lazygit"
brew "gh"
brew "glab"
# gh-dash is a `gh` extension, not a formula -- installed via
# `gh extension install dlvhdr/gh-dash` in the installer script.

# ── Observability & browsing ──────────────────────────────────────────────
brew "btop"
# GPU monitor. Homebrew's nvtop builds on both platforms since it added
# Apple Silicon (Metal) support in 3.x, not only NVIDIA/Linux.
brew "nvtop"
brew "lnav"
brew "k9s"
brew "zk"
brew "mpv"
brew "yt-dlp"

# No GUI browser cask any more -- firefox was here solely as sshbrowse's
# isolated-profile tunnel browser (see ~/.config/zsh/functions.zsh) and as a
# policy-safe fallback next to the terminal default; dropped per instruction
# rather than replaced. sshbrowse now degrades to its own "not installed"
# message if nothing named `firefox` is on PATH; install one by hand if you
# use it. $BROWSER stays terminal-browser, in a new Ghostty tab
# (~/.config/nvim/lua/util/browser.lua, dot_local/bin/executable_terminal-browser-open),
# macOS-only via term-tab's osascript, not part of this file; Linux has no
# equivalent default configured yet.

# terminal-browser: real Chromium rendering inside the terminal (Kitty
# graphics protocol), which is what makes it able to complete a JS-heavy
# OAuth/SSO flow that chawan's CSS-only engine could not -- see the removal
# note where chawan used to be, below. macOS gets the cask; Linux installs
# via the upstream script in run_onchange_before_install-packages.sh.tmpl's
# linux block, since there is no Homebrew formula for it at all (cask-only,
# and casks do not exist on Linux Homebrew).
{{ if eq .chezmoi.os "darwin" -}}
cask "terminal-browser"
{{ end -}}

# tmux dropped: zellij (added above) now carries everything it did --
# dot_config/zellij/layouts/{mobile,web,backend,sec,arch}.kdl are the
# project layouts tmux's own layout.sh used to build, and config.kdl's
# `Ctrl y` binding is the synchronize-panes toggle tmux.conf's `prefix + e`
# used to be. dot_config/tmux/ is removed (.chezmoiremove); tpm's plugin
# clones under ~/.config/tmux/plugins/ are left for a human to
# `rm -rf ~/.config/tmux` by hand after applying, since .chezmoiremove
# targets are listed files, not a directory glob.

# chawan (the CSS-only terminal browser this used to have) is removed
# entirely, not moved to optional: terminal-browser (above) replaces it and
# covers the one thing chawan genuinely could not do -- render a JS-heavy
# OAuth/SSO page. browsh, the manifest's original tui_browser_sso pick, is
# not installable at all (`brew info browsh` resolves to nothing; upstream
# has had no release since 2021) -- see the Checkpoint 4 report.
