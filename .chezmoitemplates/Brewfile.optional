# Optional package groups. NOT installed by `chezmoi apply`.
#
# The main Brewfile is the baseline every machine gets, identical everywhere:
# strictly the v12.0-audited manifest plus its implied dependencies. This file
# holds everything else this environment can use -- large toolchains, and
# tools that predate the v12.0-audited migration and moved out of the
# baseline rather than being dropped outright. It is deliberately a manual
# step rather than a prompt or a template conditional -- nothing here is
# decided by what kind of machine this is, only by someone typing a command:
#
#     brewopt            # list the groups
#     brewopt sec        # install one
#
# `brew bundle` never uninstalls, so removing a line here has no effect on a
# machine that already has the package. Uninstall by hand if that is the intent.
#
# No templating here, unlike the baseline Brewfile: `brewopt`
# (dot_config/zsh/functions.zsh) reads this file as plain text, so a
# "macOS only" marker below is documentation, not an enforced skip on
# Ubuntu -- `brewopt <group>` there will still attempt those lines and fail
# on Homebrew casks that have no Linux equivalent. Fixing that needs
# `brewopt` itself to filter by `$(uname)`; out of scope for the
# v12.0-audited migration's OS-branching checkpoint, which covers the
# templated baseline Brewfile only.

# ── sec ────────────────────────────────────────────────────────────────────
# The reverse-engineering / offensive-security toolchain. Not in the
# v12.0-audited manifest, so it moved out of the baseline; install it on a
# machine that actually does this work.
#
# For applications you are authorized to test.
brew "semgrep"
brew "jadx"
brew "apktool"
brew "nmap"
brew "nuclei"
brew "jwt-cli"
cask "mitmproxy"   # ships as a cask, not a formula
brew "osv-scanner"
brew "syft"
# frida-tools and objection are NOT brew formulae -- they are Python tools
# installed via `uv tool install frida-tools objection` (uv is baseline; see
# Brewfile). Run that by hand alongside this group. uv, not pipx: pipx
# installed them against Homebrew's python, so a `brew upgrade python`
# orphaned the venvs and broke frida-ps/objection with an error pointing
# nowhere near the cause. uv manages an interpreter per tool, so brew cannot
# reach them.

# ── mobile ─────────────────────────────────────────────────────────────────
# Mobile/iOS build tooling. Not in the v12.0-audited manifest. FVM still pins
# Flutter per-repository from each clone's `.fvm/` when installed -- see
# CLAUDE.md's identity table and never add Flutter/Dart to PATH globally.
# fvm, fastlane and scrcpy are cross-platform. android-platform-tools is
# cross-platform in spirit (adb matters for Android work on Linux too) but
# ships from Homebrew as a cask either way -- no Linux formula exists.
brew "fvm"
cask "android-platform-tools"
brew "fastlane"
brew "scrcpy"
# macOS only past this point -- Xcode's own toolchain:
brew "cocoapods"
brew "xcbeautify"
brew "xcode-build-server"
brew "swiftformat"
brew "swiftlint"

# ── arch ───────────────────────────────────────────────────────────────────
# C4 models as code. Not in the v12.0-audited manifest (d2 in the baseline
# covers architecture_and_diagrams instead). `structurizr` is the unified
# binary -- `local` serves the browser UI, `export` writes Mermaid,
# `validate`/`inspect` are the only diagnostics that exist for the DSL.
# Driven by ~/.config/zsh/c4.zsh and the c4-architect Claude Code skill.
#
# It depends on Homebrew's openjdk (already pulled in as a dependency here).
# That dependency is load-bearing, not incidental: the war is built for Java
# 21+, and Homebrew's launcher script does
# `export JAVA_HOME="${JAVA_HOME:-<brew openjdk>}"` as a FALLBACK, not a pin.
# ~/.zshenv exports mise's temurin-17 for Gradle and jdtls, so out of the box
# every structurizr call inherits Java 17 and dies with
# UnsupportedClassVersionError -- `_c4_structurizr` in c4.zsh overrides
# JAVA_HOME for this command only. Do not "simplify" that away.
brew "structurizr"
# The local image pipeline for C4 views: `c4-render` exports PlantUML and lets
# PlantUML rasterise it, with Graphviz doing the layout. `plantuml -testdot`
# checks the pair is wired up. graphviz is listed even though plantuml
# depends on it, so brew records it as installed-on-request and
# `brew autoremove` cannot take it.
brew "plantuml"
brew "graphviz"

# ── backend ────────────────────────────────────────────────────────────────
# Containers and Kubernetes, ~1 GB, for the Docker-compatible workflow the
# v12.0-audited baseline's `podman` does not cover on its own. colima is the
# VM that gives the docker CLI a daemon on macOS without Docker Desktop.
# Start it with `colima start`.
brew "colima"
brew "docker"
brew "docker-compose"
brew "kubernetes-cli"
# hadolint lints Dockerfiles, so it belongs with Docker rather than in the
# baseline. Note Mason installs its own copy too, because lazyvim.json enables
# `lang.docker` -- the nvim integration works without this line.
brew "hadolint"

# ── mobilesec ──────────────────────────────────────────────────────────────
# Image/QR extras for mobile security work.
brew "zbar"                  # decode QR codes and barcodes from images
brew "chafa"                 # render an image as ANSI art in the terminal

# ── secrets ────────────────────────────────────────────────────────────────
# TOTP tooling. Deliberately opt-in: wants per-machine setup (a seeded secret)
# that installing the binary does not give you. bitwarden-cli and infisical
# moved to the baseline -- see Brewfile.
brew "oath-toolkit"          # oathtool, for TOTP codes at the prompt

# ── extras ─────────────────────────────────────────────────────────────────
# Development and shell tooling the baseline does not need. The first three
# are optional back-ends the config calls if present and names in an error if
# not: unar and sevenzip for `extract`, watchman for the React Native cache
# reset.
brew "unar"                  # rar archives, for extract()
brew "sevenzip"              # 7z archives (binary is 7zz), for extract()
brew "watchman"              # React Native metro cache reset (<leader>rnc)
brew "jless"                 # pager for JSON
brew "pre-commit"            # git-hook framework, for repos that use it
# ghorg is not in homebrew/core, so it needs its tap named explicitly -- a bare
# `brew "ghorg"` fails to resolve.
tap "gabrie30/utils"
brew "gabrie30/utils/ghorg"  # clone every repo in an org or user

# Shell conveniences that predate the v12.0-audited migration and are not in
# it. Every alias/binding these back is guarded with a `command -v` /
# `$+commands[]` check at the call site (aliases.zsh, tools.zsh), so a machine
# without this group loses the feature silently rather than erroring -- see
# CLAUDE.md, "Things that will legitimately differ between machines".
brew "atuin"                 # Ctrl-R history search
brew "hexyl"                 # `hex` alias
brew "dust"                  # `du` alias
brew "sd"                    # sed replacement, used by the iOS sim helpers
cask "cursor-cli"            # cursor-agent, <leader>A in Neovim

# ── secextra ───────────────────────────────────────────────────────────────
# Second opinions overlapping something the baseline (or the `sec` group)
# already installs and wires up:
#   trufflehog  another secret scanner; gitleaks is the one sec.zsh, the nvim
#               scanners and the mobilesec MCP server all call
#   grype        vulnerability scanning; trivy covers it and is referenced
#   dex2jar      APK decompilation; jadx covers it and is referenced
#   ffuf         web fuzzing -- useful, but nothing here drives it
brew "trufflehog"
brew "grype"
brew "dex2jar"
brew "ffuf"

# No `desktop` group. There was one, holding 13 GUI casks -- rectangle, aldente,
# arc, obsidian, notion and the rest -- added on the reasoning that a fresh Mac
# would otherwise be missing them. That reasoning is wrong, and it is worth
# writing down so it does not get re-applied: a fresh Mac missing Rectangle is not
# a dotfiles problem. This repo is the development environment. Every machine
# should be identical on that, and free to differ on everything else.
#
# http-toolkit went with them despite genuinely being a security tool: it is the
# GUI sibling of mitmproxy, which is in the `sec` group above.
