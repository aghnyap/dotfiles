#!/usr/bin/env bash
# Re-runs automatically whenever the Brewfile below changes, because chezmoi
# hashes the rendered script and this comment embeds the file's contents.
#
# Brewfile hash: {{ includeTemplate "Brewfile" . | sha256sum }}
set -euo pipefail

command -v brew >/dev/null 2>&1 || {
  echo "Homebrew is not installed. Install it first:" >&2
  echo '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"' >&2
  exit 1
}

# --no-lock was removed from brew bundle; HOMEBREW_BUNDLE_NO_UPGRADE keeps a
# re-run from silently upgrading formulae that are merely outdated.
echo "==> brew bundle"
HOMEBREW_BUNDLE_NO_UPGRADE=1 brew bundle --file=/dev/stdin <<'BREWFILE'
{{ includeTemplate "Brewfile" . }}
BREWFILE

{{ if eq .chezmoi.os "linux" -}}
# GUI tools the baseline Brewfile could not install above -- Homebrew on
# Linux has no cask support at all, so ghostty, the Nerd Font and
# terminal-browser (all cask-only upstream) are gated out of it entirely.
# See Brewfile's comments on each for why.
echo "==> linux GUI installs (ghostty, Fira Code Nerd Font, terminal-browser)"

# Ghostty: available directly via apt on newer Ubuntu (24.10+) and via pacman
# on Arch -- https://ghostty.org/docs/install/binary. Best-effort: an older
# Ubuntu without it in the repos gets a warning, not a failed run, since
# there is no one apt source that covers every release.
if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y ghostty || \
    echo "    warn: apt has no ghostty package on this release -- see https://ghostty.org/docs/install/binary" >&2
fi

# Fira Code Nerd Font, pinned to the same release the macOS cask installs
# (v3.5.1) so both platforms draw identical glyphs. ~/.local/share/fonts is
# the per-user XDG font directory -- fontconfig reads it with no extra
# config. fc-cache rebuilds the cache so the font is visible immediately
# instead of after the next login.
font_dir="$HOME/.local/share/fonts/FiraCodeNerdFont"
if [[ ! -d $font_dir ]]; then
  mkdir -p "$font_dir"
  curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/FiraCode.tar.xz \
    | tar -xJ -C "$font_dir"
  command -v fc-cache >/dev/null 2>&1 && fc-cache -f "$font_dir" >/dev/null
fi

# terminal-browser: cask-only upstream, so no Homebrew formula exists on
# Linux either. This is upstream's own installer, checked against
# https://terminal-browser.com/ and https://github.com/zenbu-labs/terminal-browser
# before it went in this script.
command -v terminal-browser >/dev/null 2>&1 || \
  curl -fsSL https://terminal-browser.sh/install | bash
{{ end -}}

# Runtimes. Flutter is deliberately absent -- FVM pins it per repository, and a
# global SDK on PATH would shadow the per-repo pin.
#
# The versions are NOT repeated here. They come from the managed
# ~/.config/mise/config.toml, which this script cannot read yet -- it is a
# run_onchange_BEFORE, so apply has not written it. Solution: inline the
# file from source and install from it, same as the mise config write
# below always has been (there is no global ruby pin any more to compare
# it to -- see that file for why).
# Writing it first also means `mise install` pins as well as installs; the old
# `mise install java@temurin-21` installed a runtime it never activated.
echo "==> mise runtimes"
mkdir -p "$HOME/.config/mise"
cat > "$HOME/.config/mise/config.toml" <<'MISECONFIG'
{{ trim (include "dot_config/mise/config.toml") }}
MISECONFIG
mise install

# No global ruby install here any more, and no gem install for cocoapods/
# fastlane either -- both moved to Brewfile.optional's `mobile` group in
# the v12.0-audited migration (see dot_config/mise/config.toml for why the
# ruby pin specifically went with them: it served only these two gems, and
# building one on every machine is exactly what stalled Linux without dev
# headers). `brewopt mobile` installs the formulae; a project that needs
# the gem versions instead runs `mise use ruby@3.3.5` then
# `mise exec ruby -- gem install --no-document cocoapods fastlane` by hand.
# The reshim is still needed for node/java's shims to pick up anything
# `mise install` above just built.
mise reshim

# litellm and harlequin via uv, never system pip -- same reasoning as aider
# below: uv manages its own interpreter per tool, so a `brew upgrade python`
# cannot orphan them.
#
# No `|| true`: `uv tool install --force` is idempotent, so a failure here is a
# real failure and should stop the script rather than be discovered later.
echo "==> uv tools (litellm, harlequin)"
uv tool install --force "litellm[proxy]"
uv tool install --force harlequin

# frida-tools and objection moved to the `sec` group in Brewfile.optional --
# not installed here any more. `uv tool install --force frida-tools objection`
# is the manual follow-up alongside `brewopt sec`.

# aider, deliberately NOT `brew install aider` even though the formula exists and
# is current. Upstream's install docs say plainly: "It's best to install aider
# using one of methods recommended above. While aider is available in a number of
# system package managers, they often install aider with incorrect dependencies."
# Pin the version because ai_model.lua's close-before-switch safeguard and the
# managed metadata budgets are tested against its startup/model-loading path.
# To upgrade: change this pin, re-run audit.sh and bootstrap.sh, then verify in
# a real nvim session that :AiModel is blocked while aider is open and that a
# fresh launch keeps the configured max input/output budgets.
echo "==> uv tools (aider)"
uv tool install --force --python python3.12 --with pip aider-chat@0.86.2

# oh-my-zsh. Installed unattended: the upstream installer would otherwise
# launch an interactive shell and overwrite ~/.zshrc, which chezmoi owns.
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  echo "==> oh-my-zsh"
  RUNZSH=no KEEP_ZSHRC=yes CHSH=no \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# oh-my-zsh custom plugins that Homebrew's copies do not satisfy, because
# .zshrc lists them in the omz `plugins` array and omz looks under $ZSH/custom.
for repo in "zsh-users/zsh-autosuggestions" "zsh-users/zsh-syntax-highlighting"; do
  dest="$HOME/.oh-my-zsh/custom/plugins/${repo##*/}"
  [[ -d $dest ]] || git clone --depth 1 "https://github.com/$repo" "$dest"
done

# zsh plugins that Homebrew does not package. zsh-defer used to be cloned here
# too; nothing ever sourced it (see the note at the bottom of ~/.zshrc, which
# explains how to clone it if the deferred-startup experiment is ever retried).
for repo in "Aloxaf/fzf-tab"; do
  dest="$HOME/.config/zsh/plugins/${repo##*/}"
  [[ -d $dest ]] || git clone --depth 1 "https://github.com/$repo" "$dest"
done

# gh-dash, a `gh` extension rather than a formula. Needs `gh auth status` to
# succeed first -- `gh extension install` on an unauthenticated gh fails, and
# this script has no browser to run `gh auth login` interactively. Skipped
# with a notice rather than failing the whole run.
echo "==> gh extension (gh-dash)"
if gh auth status >/dev/null 2>&1; then
  gh extension install dlvhdr/gh-dash 2>/dev/null || gh extension upgrade dlvhdr/gh-dash
else
  echo "    skipped: gh is not authenticated -- run 'gh auth login', then" \
       "'gh extension install dlvhdr/gh-dash' by hand" >&2
fi

echo "==> done. Open nvim once for Mason to install its language servers."
