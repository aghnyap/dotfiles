# ╭──────────────────────────────────────────────────────────────────────────╮
# │  Interactive shell configuration                                         │
# │                                                                          │
# │  Toolchain PATH/env (Android, Java, Homebrew, mise, FVM, go)             │
# │  lives in ~/.zshenv so non-interactive shells get it too.                │
# │  See dev_paths_prepend() there.                                          │
# │                                                                          │
# │  This file only wires up the interactive experience and sources the      │
# │  modules in ~/.config/zsh/. Keep it thin; put content in a module.       │
# ╰──────────────────────────────────────────────────────────────────────────╯

# ── FPATH must not be exported ──────────────────────────────────────────────
# `fpath` is array-tied to `FPATH`. If FPATH is exported, every nested zsh --
# a tmux pane, an IDE terminal, anything that re-execs the shell -- inherits
# those directories, then this file and oh-my-zsh.sh:76,90-98 prepend a second
# copy. The `#omz fpath:` signature stored in the completion dump then no
# longer matches, so oh-my-zsh.sh:120 does `rm -f "$ZSH_COMPDUMP"` and rebuilds
# compinit from scratch: measured at 1.3s versus 0.27s warm.
#
# Un-exporting keeps the tie intact for this shell (fpath still works normally)
# while making that invalidation path unreachable for children.
#
# `typeset -U` is the other half and matters just as much: without it fpath
# accumulates duplicates (observed: 8 oh-my-zsh dirs listed twice, 23 entries
# where 13 were expected), which produces the same signature mismatch and the
# same full rebuild even when FPATH is not exported. .zshenv already does this
# for `path`; fpath needs it too.
typeset -U fpath FPATH
typeset +x FPATH

ZDOTDIR_MODULES="$HOME/.config/zsh"

# ── History ─────────────────────────────────────────────────────────────────
# Large and shared across panes: with tmux, several shells are live at once and
# a command run in one pane should be recallable in another.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY        # record timestamp + duration
setopt INC_APPEND_HISTORY      # write as you go, not just on exit
setopt SHARE_HISTORY           # ...and read back from other live shells
setopt HIST_IGNORE_ALL_DUPS    # a repeated command keeps only its newest entry
setopt HIST_IGNORE_SPACE       # leading space -> not recorded (for secrets)
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY             # expand !! onto the line instead of running it

# ── Shell behaviour ─────────────────────────────────────────────────────────
setopt AUTO_CD                 # bare directory name = cd
setopt AUTO_PUSHD              # every cd pushes onto the dir stack
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt EXTENDED_GLOB           # ^, ~, # in globs
setopt GLOB_DOTS               # globs match dotfiles
setopt INTERACTIVE_COMMENTS    # allow # comments when typing
setopt NO_BEEP
unsetopt FLOW_CONTROL          # frees Ctrl-S / Ctrl-Q for keybinds

# ── Completion fpath ────────────────────────────────────────────────────────
# Must be set BEFORE oh-my-zsh, which runs compinit itself.
fpath=(
  "$HOMEBREW_PREFIX/share/zsh/site-functions"
  "$ZDOTDIR_MODULES/completions"
  $fpath
)

# ── oh-my-zsh ───────────────────────────────────────────────────────────────
# Measured cost, warm, with these three plugins: ~230ms. Roughly 100ms of that
# is avoidable and is switched off below; the rest is the framework itself.
# If startup ever matters more than the framework does, everything oh-my-zsh
# is actually providing here is available without it -- see the note at the
# bottom of this file.
export ZSH="$HOME/.oh-my-zsh"

# Empty: Starship draws the prompt (see tools.zsh). Leaving this unset makes
# oh-my-zsh load its default theme AND lib/theme-and-appearance.zsh work it
# does not need to do -- 30ms of the 230.
ZSH_THEME=""

CASE_SENSITIVE="true"
DISABLE_AUTO_TITLE="true"
COMPLETION_WAITING_DOTS="true"
DISABLE_MAGIC_FUNCTIONS="true"    # skips the URL-quoting widgets; ~5ms
DISABLE_AUTO_UPDATE="true"        # `omz update` by hand instead of a startup check
ZSH_DISABLE_COMPFIX="true"        # skip the insecure-directory audit at every login
zstyle ':omz:update' mode disabled

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# ── Fork elimination around the oh-my-zsh load ──────────────────────────────
# This machine's fork+exec floor is 5-7ms at rest, rising past 10ms under load
# (a normal Mac is 1-2ms) -- every exec is being intercepted by an endpoint
# security agent. oh-my-zsh spawns 11 external processes per interactive
# shell and pays that tax on each: 60-80ms at rest, more when the machine is
# busy. Parsing all 21 lib files and 3 plugins is only ~62ms, so the forks, not
# the code, are the cost.
#
# The three shims below intercept the four most expensive of those execs. They
# are deliberately scoped: defined immediately before the source, removed
# immediately after, so nothing here is left shadowing a real command.

# git: called BARE (not `command git`) at two hot sites, which is what makes a
# function shim possible:
#   oh-my-zsh.sh:114          (cd $ZSH; git rev-parse HEAD)   ~24ms
#   plugins/git/git.plugin.zsh:3   git version                ~16-21ms
# The rev-parse result MUST be the real HEAD -- oh-my-zsh compares it against
# the `#omz revision:` line in the completion dump and deletes the dump when it
# differs, which would trade a 24ms fork for a full compinit rebuild. So it is
# cached against $ZSH/.git/HEAD's mtime and refreshed automatically after any
# `omz update`.
_omz_shim_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init"
[[ -d $_omz_shim_cache ]] || mkdir -p "$_omz_shim_cache"

_omz_rev_file="$_omz_shim_cache/omz-revision"
if [[ ! -s $_omz_rev_file || $ZSH/.git/HEAD -nt $_omz_rev_file ]]; then
  command git -C "$ZSH" rev-parse HEAD > "$_omz_rev_file" 2>/dev/null
fi
# Refreshed here, keyed on the git binary's own mtime so a `brew upgrade git`
# invalidates it. This used to say "written by git-aliases.zsh too" -- but the
# modules loop below skips git-aliases.zsh whenever oh-my-zsh is present, which
# is always on this machine, so nothing ever wrote it. The file was a fossil with
# no refresh path, and after any git upgrade the shim would have fed oh-my-zsh's
# `is-at-least` a stale version indefinitely.
_omz_gitver_file="$_omz_shim_cache/git-version"
if [[ ! -s $_omz_gitver_file || ${commands[git]} -nt $_omz_gitver_file ]]; then
  command git version 2>/dev/null | awk '{print $3}' > "$_omz_gitver_file"
fi

git() {
  if [[ $1 == rev-parse && $2 == HEAD ]]; then
    [[ -s $_omz_rev_file ]] && print -r -- "$(<$_omz_rev_file)" && return 0
  elif [[ $1 == version ]]; then
    [[ -s $_omz_gitver_file ]] && print -r -- "git version $(<$_omz_gitver_file)" && return 0
  fi
  command git "$@"
}

# scutil --get LocalHostName, oh-my-zsh.sh:103, ~13-14ms. This revision has no
# `[[ -z $SHORT_HOST ]]` guard, so presetting SHORT_HOST does not avoid the
# fork -- shimming is the only route. The value is static.
_omz_host_file="$_omz_shim_cache/localhostname"
[[ -s $_omz_host_file ]] || command scutil --get LocalHostName > "$_omz_host_file" 2>/dev/null
scutil() {
  [[ $1 == --get && $2 == LocalHostName && -s $_omz_host_file ]] \
    && print -r -- "$(<$_omz_host_file)" && return 0
  command scutil "$@"
}

# compinit -C: oh-my-zsh.sh:134 calls `compinit -u -d "$ZSH_COMPDUMP"`. An
# alias expands there because oh-my-zsh.sh is parsed after this file runs, and
# `autoload -U compinit` at line 79 does not clobber it (different namespace).
# -C skips the rebuild check AND both compaudit calls (~21ms) that
# ZSH_DISABLE_COMPFIX does not actually skip -- that flag only turns -i into -u.
#
# Cost of -C: a completion newly installed by Homebrew stays invisible until
# the dump is refreshed. So the dump is force-rebuilt once every 24h, and
# `omz-refresh-completions` does it on demand.
if [[ -z ${ZSH_COMPDUMP} ]]; then
  ZSH_COMPDUMP="${ZDOTDIR:-$HOME}/.zcompdump-${HOST/.*/}-${ZSH_VERSION}"
fi
if [[ -n ${ZSH_COMPDUMP}(#qN.mh+24) ]]; then
  : # dump is over 24h old -- let oh-my-zsh do its normal full compinit
else
  alias compinit='compinit -C'
fi

omz-refresh-completions() {
  command rm -f "$ZSH_COMPDUMP" "$ZSH_COMPDUMP.zwc"
  print "completion dump cleared; it rebuilds on the next new shell"
}

source "$ZSH/oh-my-zsh.sh"

unalias compinit 2>/dev/null
unset -f git scutil
unset _omz_shim_cache _omz_rev_file _omz_gitver_file _omz_host_file

# No zcompile of the completion dump here: oh-my-zsh owns it. It uses
# $ZSH_COMPDUMP (~/.zcompdump-$HOST-$ZSH_VERSION, not ~/.zcompdump) and
# byte-compiles it itself at oh-my-zsh.sh:152.

# ── Completion styling ──────────────────────────────────────────────────────
zstyle ':completion:*' menu no                                   # fzf-tab renders the menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list 'r:|=*' 'l:|=* r:|=*'        # substring, still case-sensitive
zstyle ':completion:*' special-dirs true
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/compcache"

# ── Keybindings ─────────────────────────────────────────────────────────────
bindkey -e                                     # emacs mode
bindkey '^[[A' history-search-backward         # Up: prefix-search, not blind history
bindkey '^[[B' history-search-forward
bindkey '^[[1;5C' forward-word                 # Ctrl-Right
bindkey '^[[1;5D' backward-word                # Ctrl-Left
bindkey '^[[3~' delete-char
bindkey '^H' backward-kill-word                # Ctrl-Backspace

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#565f89'   # tokyonight comment grey
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# fzf-tab is not an oh-my-zsh plugin and must load after compinit (which
# oh-my-zsh has already run) and before zsh-syntax-highlighting.
[[ -r "$ZDOTDIR_MODULES/plugins/fzf-tab/fzf-tab.plugin.zsh" ]] \
  && source "$ZDOTDIR_MODULES/plugins/fzf-tab/fzf-tab.plugin.zsh"

# ── Modules ─────────────────────────────────────────────────────────────────
# Loaded after oh-my-zsh so anything defined here deliberately shadows the
# framework rather than being silently shadowed by it.
#
# git-aliases.zsh is a FALLBACK only. oh-my-zsh's git plugin provides those
# ~200 aliases; the vendored copy exists so the config still works on a machine
# where oh-my-zsh is absent or failed to load. Sourcing both would be harmless
# but pointless, so it is skipped when the framework is present.
_mods=(aliases functions dev sec fzf tools csiu c4)
(( $+functions[omz] )) || _mods=(git-aliases $_mods)

# Each module is byte-compiled on first use and whenever it changes; zsh
# prefers a .zwc newer than its source automatically.
for _mod in $_mods; do
  _f="$ZDOTDIR_MODULES/$_mod.zsh"
  [[ -r $_f ]] || continue
  if [[ ! -s $_f.zwc || $_f -nt $_f.zwc ]]; then
    zcompile -R -- "$_f.zwc" "$_f" 2>/dev/null
  fi
  source "$_f"
done
unset _mod _f _mods

# Machine-local modules, sourced last so they can override anything above.
# ~/.config/zsh/local/ is excluded in .chezmoiignore and never leaves this
# machine -- it is where employer-specific or credential-adjacent config goes,
# the kind that should not follow the dotfiles to a personal laptop. The (N)
# glob qualifier makes an empty or missing directory a no-op.
for _f in "$ZDOTDIR_MODULES"/local/*.zsh(N); do
  source "$_f"
done
unset _f

# ── Prompt ──────────────────────────────────────────────────────────────────
# Cached: `starship init zsh` forks twice (once for the init script, once more
# for PROMPT2's continuation string). Both outputs are static for a given
# binary, so _cached_init in tools.zsh regenerates them only after an upgrade.

# ── Late completions ────────────────────────────────────────────────────────
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] \
  && source "$HOME/.dart-cli-completion/zsh-config.zsh"

# Both lazy-loaded version managers are gone: mise owns java and ruby, and needs
# no init eval at all. The ~143ms their eager init cost is simply not paid.

# ── Startup performance note ────────────────────────────────────────────────
# DO NOT record a single figure here. It rots, and this note has now been wrong
# twice for exactly that reason. The measurement is dominated by machine load,
# because the EDR agent taxes every fork (see above):
#
#   hyperfine -N --warmup 5 --runs 40 'zsh -lic exit'
#   2026-08-11, load ~3:   mean 227 ms (± 39), range 147-291
#
# The spread inside one run is larger than most changes you would make, so a mean
# is only comparable against another mean taken at the same load. To decide
# whether an edit helped, bisect the layers instead -- they are stable:
#
#   zsh -fc exit   ~12 ms   bare interpreter
#   zsh -c exit    ~13 ms   + ~/.zshenv
#   zsh -lc exit   ~21 ms   + /etc/zprofile (path_helper alone is ~8 ms) + .zprofile
#   zsh -lic exit  the rest is this file
#
# Historical, for scale: this was 475 ms (± 52) before the rework. The wins were
# lazy-loading rbenv (-119ms, since deleted outright -- mise owns ruby now) and
# SDKMAN (-24ms, both since deleted outright), byte-compiling the compdump (-38ms),
# caching each tool's `init zsh` output under ~/.cache/zsh/init (-40ms), and
# dropping the redundant `gh completion` eval since Homebrew ships _gh (-36ms).
#
# WHERE THE REMAINING TIME GOES -- re-measured 2026-08-11 with a timestamped
# xtrace (PS4='+%D{%s%6.}|%N:%i|'), because the old breakdown here had rotted:
# it blamed `mise activate` (~38ms) and atuin (~22ms), and neither runs any more
# (tools.zsh skips activate entirely and lazy-loads atuin behind a Ctrl-R stub).
# Of the three items it named, only zsh-syntax-highlighting is still on the
# critical path, at ~9ms.
#
# What actually dominates is oh-my-zsh's own startup, in subshell forks:
#   git.plugin.zsh:3     ~24ms  `$(git version)`
#   oh-my-zsh.sh:103     ~15ms  `$(scutil --get LocalHostName)`
#   oh-my-zsh.sh:139     ~13ms  `command grep` on the compdump signature
#   oh-my-zsh.sh:114/118/119  ~33ms  more `$( )` and `command grep`
#   oh-my-zsh.sh:151/153 ~18ms  `command mkdir` + `command rm` on the lock dir
#
# Two things follow, and both are why this note is worth keeping:
#
#  1. The git/scutil shims below DO fire, but they only remove the *exec*. The
#     `$( )` subshell fork survives shimming and is the larger half, so those
#     sites still cost ~33ms between them. Shimming more commands will not help.
#  2. Five of those forks use an explicit `command` prefix, which bypasses
#     function shims by design. They are unreachable from here; the only fix
#     would be patching oh-my-zsh itself.
#
# (Historical: a fastfetch greeting used to add ~65ms to every new top-level
# window, and no `zsh -lic` benchmark ever showed it, because its `-t 1` guard
# skipped when stdout was a pipe. It has since been removed -- but the lesson
# stands: a guard keyed on `-t 1` is invisible to every measurement here.)
#
# zsh-defer was tried and reverted: it moved ~55ms off the critical path but its
# queue did not drain under automated testing, and the failure is silent. It is
# no longer installed, so retrying means cloning it first:
#   git clone --depth 1 https://github.com/romkatv/zsh-defer ~/.config/zsh/plugins/zsh-defer
# then sourcing it before the modules loop and prefixing the three plugin
# `source` calls with `zsh-defer`. Verify in a NEW terminal, after a second:
#   print ${+functions[_zsh_highlight]}
# It must print 1. If it prints 0, the defer is not draining -- revert.
