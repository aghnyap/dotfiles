#!/usr/bin/env zsh
# Open a command in a new Ghostty tab of the existing window. Never a new
# window. No arguments: an empty tab running the default shell.
set -euo pipefail

cmd=
if (( $# )); then
  # Ghostty runs a surface command as `bash --noprofile --norc -c exec -l ...`
  # in Ghostty.app's own launchd environment, whose PATH is only
  # /usr/bin:/bin:/usr/sbin:/sbin -- no Homebrew, no ~/.local/bin, and no
  # .zshenv to add them. Carry the caller's PATH across explicitly, or
  # anything installed outside the system dirs fails with "not found".
  cmd="env PATH=${(q+)PATH} ${(j: :)${(q+)@}}"
fi

osascript - "$cmd" <<'APPLESCRIPT'
on run argv
  set cmd to item 1 of argv
  tell application "Ghostty"
    activate
    if cmd is "" then
      if (count of windows) is 0 then
        new window
      else
        new tab in front window
      end if
    else
      set cfg to new surface configuration
      set command of cfg to cmd
      set wait after command of cfg to false
      if (count of windows) is 0 then
        new window with configuration cfg
      else
        new tab in front window with configuration cfg
      end if
    end if
  end tell
end run
APPLESCRIPT
