# Homebrew now runs from ~/.zshenv so non-interactive shells get it too.

# `rbenv init` used to be eval'd here, at 119ms -- more than every other startup
# component combined. rbenv is gone entirely now: mise owns ruby, pinned in
# ~/.config/mise/config.toml, and its shims are on PATH from ~/.zshenv, so
# ruby/gem/bundle/pod/fastlane resolve with no init eval at all.

# /etc/zprofile ran path_helper before this file, which reorders PATH and pushes
# the toolchain dirs from ~/.zshenv behind /usr/bin. Re-assert them last, after
# everything above has had its say.
(( $+functions[dev_paths_prepend] )) && dev_paths_prepend
