// React/TS project layout -- port of dot_config/tmux/layouts/executable_layout.sh's
// "web" case. Not live-tested in this environment (no PTY) -- verify once
// with `zellij --layout ~/.config/zellij/layouts/web.kdl --session test-web`.
layout {
    // Without this, a custom layout gets none of the default UI -- no tab
    // bar (so the mode/keybind hints and the other tabs are invisible) and
    // no status bar. Matches the shape `zellij setup --dump-layout
    // default` prints for its own built-in layout.
    // Duplicated identically across all 5 layouts/*.kdl files -- zellij's
    // KDL layout format has no include/import mechanism (checked: no
    // `--dump-layout` flag, no `template=path` node, no shipped example
    // demonstrating one, as of 0.45.1). Left duplicated rather than faking
    // a fix; change one, change all five.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="editor" {
        pane command="nvim"
    }
    tab name="dev" {
        pane split_direction="vertical" {
            pane command="npm" start_suspended=true {
                args "run" "dev"
            }
            pane command="npm" start_suspended=true {
                args "run" "test" "--" "--watch"
            }
        }
    }
}
