// Mobile security project layout -- port of dot_config/tmux/layouts/executable_layout.sh's
// "sec" case: interception on the left, device/instrumentation on the right,
// plus a scan tab. All three tools here (mitmweb, frida-ps, semgrep) live in
// Brewfile.optional's `sec` group -- `brewopt sec` first. Not live-tested in
// this environment (no PTY) -- verify once with
// `zellij --layout ~/.config/zellij/layouts/sec.kdl --session test-sec`.
layout {
    // Without this, a custom layout gets none of the default UI -- no tab
    // bar (so the mode/keybind hints and the other tabs are invisible) and
    // no status bar. Matches the shape `zellij setup --dump-layout
    // default` prints for its own built-in layout.
    // Duplicated identically across all 5 layouts/*.kdl files -- zellij's
    // KDL layout format has no include/import mechanism (checked: no
    // `--dump-layout` flag, no `template=path` node, no shipped example
    // demonstrating one, as of 0.45.1). Left duplicated rather than faking
    // a fix; change one, change all five.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="editor" {
        pane command="nvim"
    }
    tab name="proxy" {
        pane split_direction="vertical" {
            pane command="mitmweb" start_suspended=true {
                args "--listen-host" "127.0.0.1" "--listen-port" "8080"
            }
            pane command="frida-ps" start_suspended=true {
                args "-U"
            }
        }
    }
    tab name="scan" {
        pane command="semgrep" start_suspended=true {
            args "--config" "p/security-audit" "."
        }
    }
}
