// d2 architecture-modelling layout -- port of dot_config/tmux/layouts/executable_layout.sh's
// "arch" case: the preview server runs immediately (matching the tmux
// version's auto-run via send-keys ... C-m), the render command sits ready
// to confirm. d2 is baseline (no `brewopt` group needed any more -- see
// .chezmoitemplates/Brewfile.optional's note where `arch` used to be).
// Not live-tested in this environment (no PTY) -- verify once with
// `zellij --layout ~/.config/zellij/layouts/arch.kdl --session test-arch`.
layout {
    // Without this, a custom layout gets none of the default UI -- no tab
    // bar (so the mode/keybind hints and the other tabs are invisible) and
    // no status bar. Matches the shape `zellij setup --dump-layout
    // default` prints for its own built-in layout.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="editor" {
        pane command="nvim"
    }
    tab name="d2" {
        // d2-local/d2-render are zsh FUNCTIONS (dot_config/zsh/d2.zsh), not
        // binaries -- zellij's `command` execs directly, bypassing an
        // interactive shell and its function definitions, so both go
        // through `zsh -lic` instead of naming the function as `command`.
        pane split_direction="horizontal" {
            pane command="zsh" {
                args "-lic" "d2-local"
            }
            pane size="30%" command="zsh" start_suspended=true {
                args "-lic" "d2-render"
            }
        }
    }
}
